OPENROUTER_API_KEY=your-key-here

# healthchecks.io — dwa osobne sekrety:
# 1. API key (hcw_...) — do zarządzania checkami przez REST API (tworzenie, listowanie)
HEALTHCHECK_API_KEY=your-healthcheck-api-key-here
# 2. Ping URL — unikalny URL konkretnego check'u, używany do pingowania po udanym runie
#    Pobierz go z dashboardu healthchecks.io lub przez API (GET /api/v3/checks/)
HEALTHCHECK_PING_URL=https://hc-ping.com/YOUR-CHECK-UUID
