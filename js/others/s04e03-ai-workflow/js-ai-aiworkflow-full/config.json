{
  "model": "anthropic/claude-haiku-4-5",
  "retry": {
    "attempts": 4,
    "minTimeoutMs": 1000,
    "factor": 2
  },
  "circuitBreaker": {
    "failureThreshold": 50,
    "timeoutMs": 10000,
    "resetTimeoutMs": 30000
  },
  "monitor": {
    "minSummaryLength": 50,
    "schemaErrorRateAlertThreshold": 0.05
  },
  "dlq": {
    "reprocessBatchSize": 3,
    "maxSize": 100
  },
  "workflow": {
    "intervalMs": 60000,
    "articles": 3
  }
}
